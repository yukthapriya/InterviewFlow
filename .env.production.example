# .env.production.example
# Copy to .env.production and fill values (DO NOT commit real secrets)

# Postgres (example local form). Use the full DATABASE_URL in production:
POSTGRES_DB=interviewflow
POSTGRES_USER=interviewflow
POSTGRES_PASSWORD=change_me

# Example DATABASE_URL (Postgres). Replace with your managed DB URL
# DATABASE_URL=postgresql://user:pass@host:5432/interviewflow

# JWT secret for auth (set a long random value)
JWT_SECRET=change_this_to_a_strong_random_value

# Executor: leave empty for safe mock executor in production demo
PISTON_URL=
PISTON_KEY=

# CORS origins (comma-separated) - set to your frontend domain in production
CORS_ORIGINS=https://your-frontend-domain.com

# Optional: set full DATABASE_URL if you prefer using it directly
# DATABASE_URL=postgresql://interviewflow:change_me@db:5432/interviewflow